---
import "@/styles/global.css";
import "@/styles/terminal.css";
import { getConfig } from "@/lib/config/client.config";
import AppLayout from "@/layouts/AppLayout.vue";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.css" />
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs" as="script" />
    <title>{getConfig("site.title")}</title>
  </head>
  <body class="text-text font-mono min-h-screen bg-base flex flex-col">
    <AppLayout client:only>
      <slot />
    </AppLayout>
  </body>
</html>
